# === App ===
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
DATA_DIR=./data
STUDY_DIR=./study
LOG_MODE=research

# === OpenAI Realtime (optional) ===
OPENAI_API_KEY=
OPENAI_REALTIME_ENABLED=false

# === Tobii (optional, Desktop only) ===
TOBII_ENABLED=false
# Path to TobiiStream.exe (only required as fallback for ZMQ if direct Tobii Pro SDK is not used)
TOBIISTREAM_PATH=
TOBII_ZMQ_ENDPOINT=tcp://127.0.0.1:5556
