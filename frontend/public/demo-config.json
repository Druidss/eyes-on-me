            "answer": 2,
            "required": true,
            "section_key": "C",
            "section_title": "Transfer & Deduction",
            "section_note": "Connect the visual evidence with what you heard."
          },
          {
            "id": "c2",
            "text": "What item did Nikolai Vance carry that is required to unlock the main gate at the Old Embankment?",
            "type": "choice",
            "options": [
              "Red security card",
              "Blue keycard",
              "Metal key bundle",
              "Electronic access device"
            ],
            "answer": 1,
            "required": true,
            "section_key": "C"
          }
        ]
      },
      "feedback": {
        "title": "Additional Feedback",
        "instruction": "If you would like, you can share any additional comments about the interaction.",
        "items": [
          {
            "id": "feedback_text",
            "text": "Your feedback (optional)",
            "type": "text",
            "required": false
          }
        ]
      }
    }
  },
