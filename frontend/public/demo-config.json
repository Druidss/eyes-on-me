            "answer": 1,
            "required": true,
            "section_key": "B"
          },
          {
            "id": "b3",
            "text": "At what specific time is the Ministry planning to initiate the raid?",
            "type": "choice",
            "options": [
              "01:00 AM",
              "02:30 AM",
              "03:00 AM",
              "04:15 AM"
            ],
            "answer": 2,
            "required": true,
            "section_key": "B"
          },
          {
            "id": "b4",
            "text": "Who did Director Vane identify as the rogue contact inside the Ministry?",
            "type": "choice",
            "options": [
              "Michael",
              "Thomas",
              "James",
              "Richard"
            ],
            "answer": 1,
            "required": true,
            "section_key": "B"
          },
          {
            "id": "b5",
            "text": "What emergency radio frequency or channel did Director Vane mention?",
            "type": "choice",
            "options": [
              "Channel 8",
              "Channel 12",
              "Channel 16",
              "Channel 22"
            ],
            "answer": 2,
            "required": true,
            "section_key": "B"
          },
          {
            "id": "b6",
            "text": "What is the secret verbal password for the field agents?",
            "type": "choice",
            "options": [
              "Blue Moon",
              "Red Sky",
              "Green Light",
              "Black Wind"
            ],
            "answer": 1,
            "required": true,
            "section_key": "B"
          },
          {
            "id": "c1",
            "text": "What security clearance level does an agent need to transmit on the emergency radio channel?",
            "type": "choice",
            "options": [
              "Level 2",
              "Level 3",
              "Level 4",
              "Level 5"
