            "options": [
              "The 7th",
              "The 14th",
              "The 21st",
              "The 28th"
            ],
            "answer": 1,
            "required": true,
            "section_key": "A",
            "section_title": "Visual Memory",
            "section_note": "Recall what you observed at the scene."
          },
          {
            "id": "a2",
            "text": "What item was the missing dockworker Nikolai Vance last seen carrying?",
            "type": "choice",
            "options": [
              "A black briefcase",
              "A leather bag",
              "A brown backpack",
              "A metal suitcase"
            ],
            "answer": 1,
            "required": true,
            "section_key": "A"
          },
          {
            "id": "a3",
            "text": "What color was the stolen keycard mentioned in the newspaper article?",
            "type": "choice",
            "options": [
              "Red",
              "Green",
              "Blue",
              "Yellow"
            ],
            "answer": 2,
            "required": true,
            "section_key": "A"
          },
          {
            "id": "a4",
            "text": "Where was the red X marked on the wall map?",
            "type": "choice",
            "options": [
              "Harbor Warehouse No. 5",
              "Old Embankment No. 12",
              "Industrial Park No. 8",
              "South of Train Station"
            ],
            "answer": 1,
            "required": true,
            "section_key": "A"
          },
          {
            "id": "a5",
            "text": "What is the case file number on the desk folder?",
            "type": "choice",
            "options": [
              "#A7-12",
              "#B3-08",
              "#C5-15",
              "#D9-20"
            ],
            "answer": 0,
            "required": true,
            "section_key": "A"
          },
          {
            "id": "a6",
            "text": "What phone extension was scribbled on the desk notepad?",
            "type": "choice",
            "options": [
              "Ext. 301",
              "Ext. 402",
              "Ext. 504",
              "Ext. 607"
            ],
            "answer": 1,
            "required": true,
            "section_key": "A"
          },
          {
            "id": "b1",
            "text": "What is the official codename of the Ministry's upcoming military operation?",
            "type": "choice",
            "options": [
              "Operation Midnight",
              "Operation Aurora",
              "Operation Silence",
              "Operation Storm"
            ],
            "answer": 1,
            "required": true,
            "section_key": "B",
            "section_title": "Auditory Memory",
            "section_note": "Recall what was said during the interrogation."
          },
          {
            "id": "b2",
            "text": "What is the name of the cargo vessel the rebels are using?",
            "type": "choice",
            "options": [
              "The Neptune",
              "The Hermes",
              "The Poseidon",
              "The Artemis"
